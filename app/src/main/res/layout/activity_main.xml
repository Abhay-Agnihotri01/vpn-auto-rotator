<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <SwitchCompat
                android:id="@+id/vpnSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vpn_enabled"
                android:textOn="@string/on"
                android:textOff="@string/off" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rotation_interval"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <SeekBar
                android:id="@+id/intervalSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="55" />

            <TextView
                android:id="@+id/intervalTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorSecondary"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/available_servers"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/refreshServersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/refresh_servers"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/initializing"
                android:textAppearance="?attr/textAppearanceBody2"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/serversListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/darker_gray"
                android:dividerHeight="1"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>